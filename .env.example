# =============================================================================
# Pi Agent Platform environment template
# =============================================================================
# Development: copy this file to .env.local.
# Production: copy to .env or inject the same values through the platform.
# .env.example is not loaded automatically.
#
# Markers:
#   REQUIRED       Always required.
#   MODE-SPECIFIC  Required only for the selected authentication mode.
#   OPTIONAL       Has a built-in default or is used only by a specific feature.

# =============================================================================
# Runtime
# =============================================================================

# OPTIONAL: development | test | production
NODE_ENV=development

# OPTIONAL: HTTP port used by the application.
PORT=8766

# REQUIRED: Public origin of the application. It must match the browser Origin.
APP_ORIGIN=http://localhost:8766

# OPTIONAL: trace | debug | info | warn | error
LOG_LEVEL=info

# =============================================================================
# Authentication
# =============================================================================

# REQUIRED: development | gateway
# development is forbidden when NODE_ENV=production.
AUTH_MODE=development

# MODE-SPECIFIC: required when AUTH_MODE=development.
# In gateway mode this value is ignored.
DEV_AUTH_USERNAME=your.username

# MODE-SPECIFIC: required when AUTH_MODE=gateway. This is the only JWT value
# normally provided by the zero-trust gateway.
AUTH_JWT_SECRET=replace-with-zero-trust-jwt-secret

# The platform defaults to HS256 and does not require these settings.
# Set AUTH_JWT_ALGORITHM only if the gateway explicitly requests HS384/HS512.
# AUTH_JWT_ALGORITHM=HS256
#
# Set issuer/audience only if the gateway explicitly requires token claims.
# AUTH_JWT_ISSUER=replace-with-gateway-issuer
# AUTH_JWT_AUDIENCE=replace-with-gateway-audience

# =============================================================================
# Storage and encryption
# =============================================================================

# REQUIRED: SQLite database file path.
APP_DATABASE_PATH=./data/platform.sqlite

# OPTIONAL: root directory for validated Skill packages.
APP_SKILLS_PATH=./data/skills

# REQUIRED: application-level encryption key for provider and channel secrets.
# Base64 must decode to exactly 32 bytes.
# Generate one with:
#   openssl rand -base64 32
CHANNEL_SECRET_KEK=replace-with-base64-encoded-32-byte-key

# =============================================================================
# Web chat
# =============================================================================

# OPTIONAL: maximum images accepted in one chat message. Allowed range: 1-20.
CHAT_MAX_IMAGES_PER_MESSAGE=10

# =============================================================================
# InfoFlow global endpoints
# =============================================================================
# InfoFlow Agent credentials are not environment variables. Set INFOFLOW_AGENT_ID,
# INFOFLOW_APP_KEY, and INFOFLOW_APP_SECRET in the Agent channel UI. They are
# encrypted in the database.

# OPTIONAL: InfoFlow API base URL.
INFOFLOW_API_BASE_URL=https://apiin.im.baidu.com/api/v1

# OPTIONAL: InfoFlow WebSocket gateway host.
INFOFLOW_WS_GATEWAY=infoflow-open-gateway.weiyun.baidu.com

# OPTIONAL: InfoFlow WebSocket connection domain and port.
INFOFLOW_WS_CONNECT_DOMAIN=infoflow-open-gateway.weiyun.baidu.com:8869

# =============================================================================
# Legacy model provider import
# =============================================================================
# Daily model calls use providers configured in the workspace UI and stored in
# the database. These two variables are used only by:
#   npm run import-env-provider

# OPTIONAL: legacy provider base URL used by the import script.
AI_BASE_URL=https://oneapi-comate.baidu-int.com/v1

# OPTIONAL: legacy provider token used by the import script.
# Never commit a real token.
AI_TOKEN=replace-with-model-gateway-token

OPEN_API_JWT_SECRET=